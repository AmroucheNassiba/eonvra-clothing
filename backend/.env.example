# EONVRA Clothing - Environment Variables
# Copy this file to .env and fill in your values

# Django
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True

# Instagram Graph API
# 1. Go to https://developers.facebook.com/
# 2. Create an App > Add Instagram Basic Display product
# 3. Get your User Access Token and User ID
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token-here
INSTAGRAM_USER_ID=your-instagram-user-id-here
